{
  "name": "@classytic/arc-next",
  "version": "0.7.0",
  "description": "React + TanStack Query SDK for Arc resources",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Classytic",
  "repository": {
    "type": "git",
    "url": "https://github.com/classytic/arc-next"
  },
  "keywords": [
    "react",
    "tanstack-query",
    "react-query",
    "crud",
    "api-client",
    "hooks",
    "optimistic-updates",
    "pagination",
    "multi-tenant",
    "arc",
    "mongokit",
    "sse",
    "real-time",
    "soft-delete",
    "bulk-operations"
  ],
  "main": "./dist/hooks.js",
  "types": "./dist/hooks.d.ts",
  "exports": {
    ".": {
      "types": "./dist/hooks.d.ts",
      "default": "./dist/hooks.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "default": "./dist/cache.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "default": "./dist/query.js"
    },
    "./mutation": {
      "types": "./dist/mutation.d.ts",
      "default": "./dist/mutation.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "default": "./dist/hooks.js"
    },
    "./query-client": {
      "types": "./dist/query-client.d.ts",
      "default": "./dist/query-client.js"
    },
    "./prefetch": {
      "types": "./dist/prefetch.d.ts",
      "default": "./dist/prefetch.js"
    },
    "./sse": {
      "types": "./dist/sse.d.ts",
      "default": "./dist/sse.js"
    },
    "./ws": {
      "types": "./dist/ws.d.ts",
      "default": "./dist/ws.js"
    },
    "./upload": {
      "types": "./dist/upload.d.ts",
      "default": "./dist/upload.js"
    },
    "./presets/soft-delete": {
      "types": "./dist/presets/soft-delete.d.ts",
      "default": "./dist/presets/soft-delete.js"
    },
    "./presets/bulk": {
      "types": "./dist/presets/bulk.d.ts",
      "default": "./dist/presets/bulk.js"
    },
    "./presets/slug": {
      "types": "./dist/presets/slug.d.ts",
      "default": "./dist/presets/slug.js"
    },
    "./presets/tree": {
      "types": "./dist/presets/tree.d.ts",
      "default": "./dist/presets/tree.js"
    },
    "./presets/search": {
      "types": "./dist/presets/search.d.ts",
      "default": "./dist/presets/search.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "push": "classytic-push",
    "release:tag": "node -e \"require('child_process').execSync('npm run push -- v'+require('./package.json').version,{stdio:'inherit'})\"",
    "release": "npm run push -- main && npm run release:tag && npm publish",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@classytic/repo-core": ">=0.4.0",
    "@tanstack/react-query": ">=5.62.0",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": false },
    "@tanstack/react-query": { "optional": false },
    "@classytic/repo-core": { "optional": false }
  },
  "devDependencies": {
    "@classytic/dev-tools": "^0.2.0",
    "@classytic/repo-core": "^0.5.0",
    "@tanstack/react-query": "^5.97.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
