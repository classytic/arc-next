  "bin": {
    "arc-next-edge": "dist/edge-cache/cli.js"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --project jsdom --project node --project ssr --project native",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "push": "classytic-push",
    "release:tag": "node -e \"require('child_process').execSync('npm run push -- v'+require('./package.json').version,{stdio:'inherit'})\"",
    "release": "npm run push -- main && npm run release:tag && npm publish",
    "prepublishOnly": "npm run gate",
    "gate": "npm run typecheck && npm run typecheck:tests && npm run lint && npm run check:dead-code && npm test && npm run test:types && npm run build && npm run check:package && npm run check:api-surface && npm run check:server-import && npm run check:rn-boundary && npm run check:bundle && npm run check:fixtures && npm run check:skills",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "check:api-surface": "node scripts/check-api-surface.mjs",
    "api:surface": "node scripts/check-api-surface.mjs --update",
    "check:server-import": "node scripts/check-server-import.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:fixtures": "tsc -p fixtures/tsconfig.json",
    "check:skills": "node scripts/check-skills.mjs",
    "check:peer-floors": "node scripts/check-peer-floors.mjs",
    "lint": "npm run lint:biome && npm run lint:query",
    "check:dead-code": "knip",
    "check:rn-boundary": "node scripts/check-rn-boundary.mjs",
    "lint:query": "node tools/lint-query/node_modules/eslint/bin/eslint.js -c tools/lint-query/eslint.config.js --max-warnings 0 src",
    "lint:query:install": "npm --prefix tools/lint-query ci",
    "lint:biome": "biome check src/ tests/ scripts/ fixtures/ tools/lint-query/eslint.config.js",
    "test:types": "vitest run --project types",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@classytic/repo-core": ">=0.38.0",
    "@tanstack/react-query": ">=5.102.0",
    "@tanstack/react-query-devtools": ">=5.102.0",
    "jose": ">=4.8.1",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "@tanstack/react-query": {
      "optional": false
    },
    "@classytic/repo-core": {
      "optional": false
    },
    "jose": {
      "optional": true
    },
    "@tanstack/react-query-devtools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.4",
    "@classytic/dev-tools": "^0.2.1",
    "@classytic/repo-core": "^0.38.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-istanbul": "^5.1.0",
    "jose": "^6.2.15",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
